    CASE WHEN m.tx_id IS NOT NULL THEN 1 ELSE 0 END\
) > 0\
\
ORDER BY\
    SUM(CASE WHEN m.tx_id IS NOT NULL THEN 1 ELSE 0 END) DESC,\
    f.time_step\
